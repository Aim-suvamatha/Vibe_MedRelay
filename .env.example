# =============================================================
# MedRelay — ตัวอย่าง Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#   cp .env.example .env.local
# ห้าม commit .env.local เข้า git เด็ดขาด (ถูกกันไว้ใน .gitignore แล้ว)
# =============================================================

# ---- Supabase (จาก Supabase Dashboard > Project Settings > API) ----
# URL ของโปรเจกต์ Supabase — เปิดเผยได้ ใช้ใน browser
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# anon key — เปิดเผยได้ เพราะการเข้าถึงข้อมูลถูกคุมด้วย RLS อีกชั้น
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...ตัวอย่างเท่านั้น

# service_role key — ข้ามทุก RLS policy
# ใช้ได้เฉพาะฝั่ง server (Route Handler / Server Action) เท่านั้น
# ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามใช้ในไฟล์ที่มี "use client"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...ตัวอย่างเท่านั้น

# ---- Application AI (External LLM API) ----
# ใช้กับฟีเจอร์ AI ที่ผู้ใช้ระบบเรียกใช้ เช่น สรุปข้อความส่งมอบผู้ป่วย
# เรียกจากฝั่ง server เท่านั้น ห้ามส่ง key ลง browser
LLM_API_KEY=sk-...ตัวอย่างเท่านั้น
LLM_API_BASE_URL=https://api.example.com/v1
LLM_MODEL=model-name-here

# ---- Application ----
NEXT_PUBLIC_APP_NAME=MedRelay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ค่าเริ่มต้นต้องเป็น false เสมอ ระบบนี้ห้ามรับข้อมูลผู้ป่วยจริงในเฟส prototype
NEXT_PUBLIC_ALLOW_REAL_PATIENT_DATA=false

# ---- Feature flags (เปิด/ปิดฟีเจอร์ที่ยังไม่พร้อม) ----
NEXT_PUBLIC_FEATURE_AI_SUMMARY=false
NEXT_PUBLIC_FEATURE_OFFLINE_QUEUE=false
